{
  "name": "BONY-XMD",
  "description": "BONY XMD WhatsApp Bot",
  "logo": "https://files.catbox.moe/8gwzln.jpg",
  "keywords": ["whatsapp", "bot", "bony", "xmd", "baileys"],
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp Session ID",
      "required": true,
      "value": ""
    },
    "PREFIX": {
      "description": "Bot Prefix",
      "required": false,
      "value": "."
    },
    "MODE": {
      "description": "public or private",
      "required": false,
      "value": "public"
    },
    "OWNER_NUMBER": {
      "description": "Owner number with country code",
      "required": false,
      "value": ""
    },
    "OWNER_NAME": {
      "description": "Owner Name",
      "required": false,
      "value": "Bony"
    }
  }
}
