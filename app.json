{
  "name": "BONY-XMD",
  "description": "The Best WhatsApp Bot by Bony Tech",
  "keywords": ["bot", "whatsapp", "bony-xmd", "blaze"],
  "logo": "https://files.catbox.moe/8gwzln.jpg",
  "repository": "https://github.com/YOUR_USERNAME/BONY-XMD",
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Paste your SESSION_ID here. Get from https://blaze-tech-pair-site.onrender.com/",
      "required": true,
      "value": ""
    },
    "PREFIX": {
      "description": "Bot prefix",
      "required": false,
      "value": "."
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number with country code",
      "required": false,
      "value": ""
    },
    "MODE": {
      "description": "Bot mode public/private",
      "required": false,
      "value": "public"
    }
  }
}
