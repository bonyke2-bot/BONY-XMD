module.exports = (sock) => {
    sock.ev.on("group-participants.update", async (anu) => {
        try {
            const chatId = anu.id;
            const participants = anu.participants;
            const action = anu.action; // "add" pou rantre, "remove" oswa "leave" pou soti

            for (const num of participants) {
                let userName = num.split("@")[0];
                let profilePic;

                try {
                    profilePic = await sock.profilePictureUrl(num, "image");
                } catch {
                    profilePic = "https://files.catbox.moe/vv674d.jpg";
                }

                if (action === "add") {
                    const welcomeText = `
╭━━━〔 *WELCOME* 〕━━━⬣
┃ 👋 Hello @${userName}!
┃ Welcome to the group. 
┃ We are glad to have you here!
┃ 🤖 *Bot:* RIFT-MD
╰━━━━━━━━━━━━━━━⬣`.trim();

                    await sock.sendMessage(chatId, {
                        image: { url: profilePic },
                        caption: welcomeText,
                        mentions: [num]
                    });
                } 
                else if (action === "remove" || action === "leave") {
                    const goodbyeText = `
╭━━━〔 *GOODBYE* 〕━━━⬣
┃ 👋 Goodbye @${userName}!
┃ Hope to see you again.
┃ 🤖 *Bot:* RIFT-MD
╰━━━━━━━━━━━━━━━⬣`.trim();

                    await sock.sendMessage(chatId, {
                        image: { url: profilePic },
                        caption: goodbyeText,
                        mentions: [num]
                    });
                }
            }
        } catch (e) {
            console.error("Group Participants Event Error:", e);
        }
    });
};
